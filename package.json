{
  "name": "veyra",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first AI interview copilot desktop application.",
  "author": {
    "name": "Veyra"
  },
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run build:client && npm run build:electron",
    "build:client": "vite build",
    "build:electron": "tsc -p tsconfig.desktop.json",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node scripts/clean.js",
    "dev:electron": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "veyra:model:test": "tsx scripts/test-local-model.ts",
    "veyra:voice:test": "tsx scripts/test-local-voice.ts",
    "veyra:cloud:test": "tsx scripts/test-cloud-model.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@tanstack/react-query": "^5.90.16",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "electron-store": "^10.1.0",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^0.468.0",
    "onnxruntime-node": "^1.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.9.6",
    "systeminformation": "^5.33.9",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.57.0",
    "@types/babel__core": "^7.20.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "playwright": "^1.57.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.0.15",
    "wait-on": "^9.0.3"
  }
}
